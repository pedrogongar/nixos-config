; ─────────────────────────────────────────────
;  VARIABLES — solo lo que usa el panel derecho
;  La barra ahora es Waybar
; ─────────────────────────────────────────────

(defpoll cpu-porcentaje
  :interval "3s"
  :initial "0"
  `top -bn1 | grep "Cpu(s)" | awk '{print int($2)}'`)

(defpoll ram-usado
  :interval "5s"
  :initial "0G"
  `free -h | awk '/^Mem/ {print $3}'`)

(defpoll ram-porcentaje
  :interval "5s"
  :initial "0"
  `free | awk '/^Mem/ {printf "%.0f", $3/$2*100}'`)

(defpoll disco-porcentaje
  :interval "30s"
  :initial "0"
  `df -h / | awk 'NR==2 {gsub("%",""); print $5}'`)

(defpoll disco-usado
  :interval "30s"
  :initial "0G / 0G"
  `df -h / | awk 'NR==2 {print $3 " / " $2}'`)

; ── Música ──
(defpoll musica-titulo
  :interval "2s"
  :initial ""
  `playerctl metadata title 2>/dev/null | head -c 30 || echo ""`)

(defpoll musica-artista
  :interval "2s"
  :initial ""
  `playerctl metadata artist 2>/dev/null | head -c 24 || echo ""`)

(defpoll musica-estado
  :interval "2s"
  :initial "Stopped"
  `playerctl status 2>/dev/null || echo "Stopped"`)

(defpoll musica-progreso
  :interval "2s"
  :initial "0"
  `bash ~/.config/eww/scripts/musica-progreso.sh`)

; ── Pomodoro ──
(defpoll pomo-estado
  :interval "1s"
  :initial `bash ~/.config/eww/scripts/pomodoro.sh status`
  `bash ~/.config/eww/scripts/pomodoro.sh tick; bash ~/.config/eww/scripts/pomodoro.sh status`)


; ─────────────────────────────────────────────
;  WIDGET MÚSICA
; ─────────────────────────────────────────────

(defwidget widget-musica []
  (revealer
    :transition "slidedown"
    :reveal {musica-estado != "Stopped"}
    :duration "300ms"
    (box
      :class "widget widget-musica"
      :orientation "v"
      :spacing 10
      (box
        :orientation "h"
        :spacing 12
        :valign "center"
        (box
          :class "musica-caratula"
          :width 48
          :height 48
          (label :class "musica-caratula-icono" :text "♪"))
        (box
          :orientation "v"
          :spacing 2
          :valign "center"
          :hexpand true
          (label :class "musica-titulo"
            :text {musica-titulo == "" ? "Sin reproducción" : musica-titulo}
            :truncate true
            :xalign 0)
          (label :class "musica-artista"
            :text musica-artista
            :truncate true
            :xalign 0)))
      (scale
        :class "musica-progreso"
        :value musica-progreso
        :min 0 :max 100
        :draw-value false
        :onchange "playerctl position $(echo '{}' | awk -v p='{}' -v d=$(playerctl metadata mpris:length 2>/dev/null || echo 0) 'BEGIN{print p/100*d/1000000}')")
      (box
        :class "musica-controles"
        :orientation "h"
        :halign "center"
        :spacing 20
        (button :class "ctrl-btn"
          :onclick "playerctl previous"
          (label :text "󰒮"))
        (button :class "ctrl-btn ctrl-play"
          :onclick "playerctl play-pause"
          (label :text {musica-estado == "Playing" ? "󰏤" : "󰐊"}))
        (button :class "ctrl-btn"
          :onclick "playerctl next"
          (label :text "󰒭"))))))


; ─────────────────────────────────────────────
;  WIDGET POMODORO
; ─────────────────────────────────────────────

(defwidget widget-pomodoro []
  (box
    :class "widget widget-pomodoro"
    :orientation "v"
    :spacing 12
    (box :orientation "h" :spacing 8
      (label
        :class "pomo-titulo"
        :text {pomo-estado.mode == "work" ? "FOCO" : "DESCANSO"}
        :xalign 0
        :hexpand true)
      (label
        :class "pomo-sesiones"
        :text "${pomo-estado.sessions} 󰔟"))
    (label
      :class "pomo-tiempo"
      :text {pomo-estado.time}
      :halign "center")
    (scale
      :class "pomo-barra"
      :value {pomo-estado.progress}
      :min 0 :max 100
      :draw-value false)
    (box
      :orientation "h"
      :halign "center"
      :spacing 8
      (button
        :class "pomo-btn"
        :onclick "bash ~/.config/eww/scripts/pomodoro.sh reset"
        (label :text "󰑐"))
      (button
        :class {pomo-estado.status == "running" ? "pomo-btn pomo-btn-activo" : "pomo-btn pomo-btn-play"}
        :onclick "bash ~/.config/eww/scripts/pomodoro.sh pause"
        (label :text {pomo-estado.status == "running" ? "󰏤" : "󰐊"}))
      (button
        :class "pomo-btn"
        :onclick "bash ~/.config/eww/scripts/pomodoro.sh skip"
        (label :text "󰒭")))))


; ─────────────────────────────────────────────
;  WIDGET SISTEMA
; ─────────────────────────────────────────────

(defwidget widget-sistema []
  (box
    :class "widget widget-sistema"
    :orientation "v"
    :spacing 14
    (label :class "sistema-titulo" :text "SISTEMA" :xalign 0)
    (box :orientation "v" :spacing 4
      (box :orientation "h"
        (label :class "metrica-etiqueta" :text "CPU" :xalign 0 :hexpand true)
        (label :class "metrica-valor" :text "${cpu-porcentaje}%"))
      (scale
        :class "metrica-barra metrica-barra-cpu"
        :value cpu-porcentaje
        :min 0 :max 100
        :draw-value false))
    (box :orientation "v" :spacing 4
      (box :orientation "h"
        (label :class "metrica-etiqueta" :text "RAM" :xalign 0 :hexpand true)
        (label :class "metrica-valor" :text ram-usado))
      (scale
        :class "metrica-barra metrica-barra-ram"
        :value ram-porcentaje
        :min 0 :max 100
        :draw-value false))
    (box :orientation "v" :spacing 4
      (box :orientation "h"
        (label :class "metrica-etiqueta" :text "SSD" :xalign 0 :hexpand true)
        (label :class "metrica-valor" :text disco-usado))
      (scale
        :class "metrica-barra metrica-barra-ssd"
        :value disco-porcentaje
        :min 0 :max 100
        :draw-value false))))


; ─────────────────────────────────────────────
;  PANEL + WINDOW — solo escritorio
; ─────────────────────────────────────────────

(defwidget panel-escritorio []
  (box
    :class "panel-escritorio"
    :orientation "v"
    :spacing 10
    :valign "start"
    (widget-musica)
    (widget-pomodoro)
    (widget-sistema)))

(defwindow escritorio
  :monitor 0
  :geometry (geometry
    :x "8px"
    :y "64px"
    :width "220px"
    :anchor "top right")
  :stacking "overlay"
  :exclusive false
  :focusable false
  :namespace "eww-escritorio"
  (panel-escritorio))
