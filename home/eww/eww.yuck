; ─────────────────────────────────────────────
;  VARIABLES — polling del sistema
; ─────────────────────────────────────────────

(defpoll hora
  :interval "1s"
  :initial "00:00"
  `date '+%H:%M'`)

(defpoll fecha-corta
  :interval "60s"
  :initial "lun 01 ene"
  `date '+%a %d %b' | tr '[:upper:]' '[:lower:]'`)

(defpoll cpu-porcentaje
  :interval "3s"
  :initial "0"
  `top -bn1 | grep "Cpu(s)" | awk '{print int($2)}'`)

(defpoll ram-usado
  :interval "5s"
  :initial "0G"
  `free -h | awk '/^Mem/ {print $3}'`)

(defpoll ram-porcentaje
  :interval "5s"
  :initial "0"
  `free | awk '/^Mem/ {printf "%.0f", $3/$2*100}'`)

(defpoll disco-porcentaje
  :interval "30s"
  :initial "0"
  `df -h / | awk 'NR==2 {gsub("%",""); print $5}'`)

(defpoll disco-usado
  :interval "30s"
  :initial "0G / 0G"
  `df -h / | awk 'NR==2 {print $3 " / " $2}'`)

(defpoll bateria-porcentaje
  :interval "30s"
  :initial "100"
  `cat /sys/class/power_supply/BAT0/capacity 2>/dev/null || echo "100"`)

(defpoll bateria-estado
  :interval "30s"
  :initial "Charging"
  `cat /sys/class/power_supply/BAT0/status 2>/dev/null || echo "AC"`)

(defpoll volumen-valor
  :interval "2s"
  :initial "65"
  `wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{printf "%.0f", $2*100}'`)

(defpoll red-icono
  :interval "10s"
  :initial "󰤨"
  `bash ~/.config/eww/scripts/red-icono.sh`)

; ── Música vía playerctl ──
(defpoll musica-titulo
  :interval "2s"
  :initial ""
  `playerctl metadata title 2>/dev/null | head -c 30 || echo ""`)

(defpoll musica-artista
  :interval "2s"
  :initial ""
  `playerctl metadata artist 2>/dev/null | head -c 24 || echo ""`)

(defpoll musica-estado
  :interval "2s"
  :initial "Stopped"
  `playerctl status 2>/dev/null || echo "Stopped"`)

(defpoll musica-progreso
  :interval "2s"
  :initial "0"
  `bash ~/.config/eww/scripts/musica-progreso.sh`)

; ── Workspaces vía Hyprland ──
(defpoll workspaces
  :interval "0.5s"
  :initial "[]"
  `hyprctl workspaces -j 2>/dev/null || echo "[]"`)

(defpoll workspace-activo
  :interval "0.5s"
  :initial "1"
  `hyprctl activeworkspace -j 2>/dev/null | jq '.id' || echo "1"`)


; ─────────────────────────────────────────────
;  WIDGETS — BAR
; ─────────────────────────────────────────────

(defwidget barra-workspaces []
  (box
    :class "seccion-barra seccion-izquierda"
    :orientation "h"
    :space-evenly false
    :spacing 2
    (for ws in workspaces
      (button
        :class {ws.id == workspace-activo ? "workspace workspace-activo" :
                ws.windows > 0 ? "workspace workspace-ocupado" : "workspace"}
        :onclick "hyprctl dispatch workspace ${ws.id}"
        (label :text {ws.id})))))

(defwidget barra-reloj []
  (box
    :class "seccion-barra seccion-centro"
    :orientation "h"
    :space-evenly false
    :spacing 6
    (label :class "hora-barra" :text hora)
    (label :class "fecha-barra" :text fecha-corta)))

(defwidget barra-tray []
  (box
    :class "seccion-barra seccion-derecha"
    :orientation "h"
    :space-evenly false
    :spacing 0
    ; CPU
    (box :class "tray-item tray-cpu" :orientation "h" :spacing 5
      (label :class "tray-icono" :text "󰻠")
      (label :class "tray-valor" :text "${cpu-porcentaje}%"))
    ; RAM
    (box :class "tray-item tray-ram" :orientation "h" :spacing 5
      (label :class "tray-icono" :text "󰍛")
      (label :class "tray-valor" :text ram-usado))
    ; Batería
    (box :class "tray-item tray-bateria" :orientation "h" :spacing 5
      (label :class "tray-icono"
        :text {bateria-estado == "Charging" ? "󰂄" :
               bateria-porcentaje > 80 ? "󰁹" :
               bateria-porcentaje > 50 ? "󰁾" :
               bateria-porcentaje > 20 ? "󰁼" : "󰁺"})
      (label :class "tray-valor" :text "${bateria-porcentaje}%"))
    ; Volumen
    (box :class "tray-item tray-volumen" :orientation "h" :spacing 5
      (label :class "tray-icono"
        :text {volumen-valor > 70 ? "󰕾" :
               volumen-valor > 30 ? "󰖀" : "󰕿"})
      (label :class "tray-valor" :text "${volumen-valor}%"))
    ; Red
    (box :class "tray-item tray-red" :orientation "h" :spacing 0
      (label :class "tray-icono" :text red-icono))))

(defwidget barra []
  (centerbox
    :orientation "h"
    :class "barra-contenedor"
    (box :hexpand false (barra-workspaces))
    (barra-reloj)
    (box :halign "end" :hexpand false (barra-tray))))


; ─────────────────────────────────────────────
;  WIDGETS — ESCRITORIO
; ─────────────────────────────────────────────

; ── Widget Música ──
(defwidget widget-musica []
  (revealer
    :transition "slidedown"
    :reveal {musica-estado != "Stopped"}
    :duration "300ms"
    (box
      :class "widget widget-musica"
      :orientation "v"
      :spacing 10
      ; Cabecera: carátula + info
      (box
        :orientation "h"
        :spacing 12
        :valign "center"
        (box
          :class "musica-caratula"
          :width 48
          :height 48
          (label :class "musica-caratula-icono" :text "♪"))
        (box
          :orientation "v"
          :spacing 2
          :valign "center"
          :hexpand true
          (label :class "musica-titulo"
            :text {musica-titulo == "" ? "Sin reproducción" : musica-titulo}
            :truncate true
            :xalign 0)
          (label :class "musica-artista"
            :text musica-artista
            :truncate true
            :xalign 0)))
      ; Barra de progreso
      (scale
        :class "musica-progreso"
        :value musica-progreso
        :min 0
        :max 100
        :draw-value false
        :onchange "playerctl position $(echo '{}' | awk -v p='{}' -v d=$(playerctl metadata mpris:length 2>/dev/null || echo 0) 'BEGIN{print p/100*d/1000000}')")
      ; Controles
      (box
        :class "musica-controles"
        :orientation "h"
        :halign "center"
        :spacing 20
        (button :class "ctrl-btn"
          :onclick "playerctl previous"
          (label :text "󰒮"))
        (button :class "ctrl-btn ctrl-play"
          :onclick "playerctl play-pause"
          (label :text {musica-estado == "Playing" ? "󰏤" : "󰐊"}))
        (button :class "ctrl-btn"
          :onclick "playerctl next"
          (label :text "󰒭"))))))

; ── Widget Sistema ──
(defwidget widget-sistema []
  (box
    :class "widget widget-sistema"
    :orientation "v"
    :spacing 14
    (label :class "sistema-titulo" :text "SISTEMA" :xalign 0)
    ; CPU
    (box :orientation "v" :spacing 4
      (box :orientation "h"
        (label :class "metrica-etiqueta" :text "CPU" :xalign 0 :hexpand true)
        (label :class "metrica-valor" :text "${cpu-porcentaje}%"))
      (scale
        :class "metrica-barra metrica-barra-cpu"
        :value cpu-porcentaje
        :min 0 :max 100
        :draw-value false))
    ; RAM
    (box :orientation "v" :spacing 4
      (box :orientation "h"
        (label :class "metrica-etiqueta" :text "RAM" :xalign 0 :hexpand true)
        (label :class "metrica-valor" :text ram-usado))
      (scale
        :class "metrica-barra metrica-barra-ram"
        :value ram-porcentaje
        :min 0 :max 100
        :draw-value false))
    ; SSD
    (box :orientation "v" :spacing 4
      (box :orientation "h"
        (label :class "metrica-etiqueta" :text "SSD" :xalign 0 :hexpand true)
        (label :class "metrica-valor" :text disco-usado))
      (scale
        :class "metrica-barra metrica-barra-ssd"
        :value disco-porcentaje
        :min 0 :max 100
        :draw-value false))))

; ── Panel de widgets del escritorio ──
(defwidget panel-escritorio []
  (box
    :class "panel-escritorio"
    :orientation "v"
    :spacing 10
    :valign "start"
    (widget-musica)
    (widget-sistema)))


; ─────────────────────────────────────────────
;  WINDOWS
; ─────────────────────────────────────────────

(defwindow barra
  :monitor 0
  :geometry (geometry
    :y "8px"
    :height "44px"
    :anchor "top center")
  :stacking "fg"
  :exclusive true
  :namespace "eww-barra"
  (barra))

(defwindow escritorio
  :monitor 0
  :geometry (geometry
    :x "8px"
    :y "64px"
    :width "220px"
    :anchor "top right")
  :stacking "overlay"
  :exclusive false
  :focusable false
  :namespace "eww-escritorio"
  (panel-escritorio))
