;; ============ VARIABLES ============

(deflisten workspaces
  `bash -c 'hyprctl workspaces -j | jq -c "sort_by(.id)"; socat -u UNIX-CONNECT:$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock - | while read -r _; do hyprctl workspaces -j | jq -c "sort_by(.id)"; done'`)

(deflisten active-workspace
  `bash -c 'hyprctl activeworkspace -j | jq -r ".id"; socat -u UNIX-CONNECT:$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock - | while read -r _; do hyprctl activeworkspace -j | jq -r ".id"; done'`)

(defpoll clock-time :interval "1s" `date +%H:%M`)
(defpoll clock-seconds :interval "1s" `date +%S`)
(defpoll clock-date :interval "60s" `date "+%a %d %b"`)
(defpoll clock-date-long :interval "60s" `date "+%A %d de %B"`)

(defpoll cpu-usage :interval "2s"
  `top -bn1 | grep "Cpu(s)" | awk '{print int($2)}'`)

(defpoll ram-usage :interval "2s"
  `free -m | awk '/Mem:/ {print int($3/$2*100)}'`)

(defpoll ram-used :interval "2s"
  `free -h | awk '/Mem:/ {print $3}'`)

(defpoll disk-usage :interval "30s"
  `df -h / | awk 'NR==2 {gsub("%",""); print $5}'`)

(defpoll volume :interval "1s"
  `pamixer --get-volume 2>/dev/null || echo 0`)

(defpoll battery :interval "10s"
  `cat /sys/class/power_supply/BAT0/capacity 2>/dev/null || echo 100`)

(defpoll network-name :interval "10s"
  `nmcli -t -f active,ssid dev wifi 2>/dev/null | grep '^sí' | cut -d: -f2 || echo "LAN"`)

(defpoll music-title :interval "2s"
  `playerctl metadata title 2>/dev/null || echo ""`)

(defpoll music-artist :interval "2s"
  `playerctl metadata artist 2>/dev/null || echo ""`)

(defpoll music-status :interval "1s"
  `playerctl status 2>/dev/null || echo "Stopped"`)

;; ============ BAR WIDGETS ============

(defwidget workspaces-widget []
  (box :class "workspaces" :spacing 4
    (for ws in workspaces
      (button
        :class {ws.id == active-workspace ? "ws active" : "ws"}
        :onclick "hyprctl dispatch workspace ${ws.id}"
        {ws.id}))))

(defwidget bar-clock []
  (box :class "clock" :spacing 8
    (label :class "clock-time" :text clock-time)
    (label :class "clock-date" :text clock-date)))

(defwidget cpu-widget []
  (box :class "tray-item cpu" :spacing 6
    (label :class "tray-icon" :text "󰻠")
    (label :class "tray-value" :text "${cpu-usage}%")))

(defwidget ram-widget []
  (box :class "tray-item ram" :spacing 6
    (label :class "tray-icon" :text "󰍛")
    (label :class "tray-value" :text ram-used)))

(defwidget volume-widget []
  (eventbox
    :onclick "pamixer -t"
    :onscroll "if [ '{}' = 'up' ]; then pamixer -i 5; else pamixer -d 5; fi"
    (box :class "tray-item volume" :spacing 6
      (label :class "tray-icon" :text {volume > 50 ? "󰕾" : volume > 0 ? "󰖀" : "󰝟"})
      (label :class "tray-value" :text "${volume}%"))))

(defwidget battery-widget []
  (box :class "tray-item battery" :spacing 6
    (label :class "tray-icon"
      :text {battery > 80 ? "󰁹" : battery > 60 ? "󰂀" : battery > 40 ? "󰁾" : battery > 20 ? "󰁼" : "󰁺"})
    (label :class "tray-value" :text "${battery}%")))

(defwidget network-widget []
  (box :class "tray-item network" :spacing 6
    (label :class "tray-icon" :text "󰤨")))

(defwidget bar-left []
  (box :halign "start" :class "bar-section"
    (workspaces-widget)))

(defwidget bar-center []
  (box :halign "center" :class "bar-section"
    (bar-clock)))

(defwidget bar-right []
  (box :halign "end" :class "bar-section" :spacing 4
    (cpu-widget)
    (ram-widget)
    (battery-widget)
    (volume-widget)
    (network-widget)))

(defwidget bar-layout []
  (centerbox
    (bar-left)
    (bar-center)
    (bar-right)))

;; ============ DESKTOP WIDGETS ============

(defwidget big-clock []
  (box :class "widget-box clock-box" :orientation "v" :spacing 4
    (box :halign "center" :spacing 0
      (label :class "big-time" :text clock-time)
      (label :class "big-seconds" :text ":${clock-seconds}"))
    (box :class "clock-divider")
    (label :class "big-date" :text clock-date-long)))

(defwidget music []
  (box :class "widget-box music-box" :orientation "v" :spacing 10
    :visible {music-title != ""}
    (box :spacing 12
      (box :class "music-art" :halign "start"
        (label :text "♪"))
      (box :orientation "v" :valign "center" :hexpand true
        (label :class "music-title" :halign "start" :limit-width 22 :text music-title)
        (label :class "music-artist" :halign "start" :text music-artist)))
    (box :class "music-controls" :halign "center" :spacing 24
      (button :class "music-btn" :onclick "playerctl previous" "⏮")
      (button :class "music-btn play" :onclick "playerctl play-pause"
        {music-status == "Playing" ? "⏸" : "▶"})
      (button :class "music-btn" :onclick "playerctl next" "⏭"))))

(defwidget sys-ring [value label color]
  (box :orientation "v" :spacing 6 :halign "center"
    (overlay
      (circular-progress
        :class "ring-bg"
        :thickness 4
        :value 100
        :start-at 75)
      (circular-progress
        :class "ring ${color}"
        :thickness 4
        :value value
        :start-at 75)
      (label :class "ring-value" :text "${value}%"))
    (label :class "ring-label" :text label)))

(defwidget sysmon []
  (box :class "widget-box sysmon-box" :orientation "v" :spacing 14
    (label :class "sysmon-title" :halign "start" :text "SISTEMA")
    (box :spacing 20 :halign "center"
      (sys-ring :value cpu-usage :label "CPU" :color "cpu")
      (sys-ring :value ram-usage :label "RAM" :color "ram")
      (sys-ring :value disk-usage :label "SSD" :color "disk"))))

;; ============ WINDOWS ============

(defwindow bar
  :monitor 0
  :geometry (geometry
    :x "0px"
    :y "8px"
    :width "99%"
    :height "42px"
    :anchor "top center")
  :stacking "fg"
  :exclusive true
  :namespace "eww-bar"
  (bar-layout))

(defwindow desktop-clock
  :monitor 0
  :geometry (geometry
    :x "-20px"
    :y "70px"
    :anchor "top right")
  :stacking "bg"
  :focusable false
  :namespace "eww-widget"
  (big-clock))

(defwindow desktop-music
  :monitor 0
  :geometry (geometry
    :x "-20px"
    :y "220px"
    :anchor "top right")
  :stacking "bg"
  :focusable false
  :namespace "eww-widget"
  (music))

(defwindow desktop-sysmon
  :monitor 0
  :geometry (geometry
    :x "-20px"
    :y "360px"
    :anchor "top right")
  :stacking "bg"
  :focusable false
  :namespace "eww-widget"
  (sysmon))
