      "const props = defineProps<{",
      "  $1",
      "}>()",
      "",
      "const emit = defineEmits<{",
      "  $2",
      "}>()",
      "$0",
      "</script>",
      "",
      "<template>",
      "  <div>",
      "    ",
      "  </div>",
      "</template>"
    ],
    "description": "Vue 3 SFC: script setup con defineProps + defineEmits + template"
  }
