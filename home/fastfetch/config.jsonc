{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "separator": "  ",
    "color": {
      "separator": "58;40;40"
    },
    "key": {
      "width": 12
    }
  },
  "modules": [
    // ── Identidad (oro — protagonista)
    { "type": "title",    "key": "󰀄 user",     "keyColor": "232;192;32",  "format": "{1}@{2}" },
    { "type": "os",       "key": "󰣇 distro",   "keyColor": "196;48;48",   "format": "{3} {12}" },
    { "type": "kernel",   "key": "󰒋 kernel",   "keyColor": "232;192;32",  "format": "{1} {2}" },
    "break",
    // ── Hardware (rojo/ambar — urgencia, recursos)
    { "type": "cpu",      "key": "󰻠 cpu",      "keyColor": "196;48;48",   "format": "{1}" },
    { "type": "gpu",      "key": "󰢮 gpu",      "keyColor": "224;136;48",  "format": "{2}" },
    { "type": "memory",   "key": "󰍛 memory",   "keyColor": "196;48;48",   "format": "{1} / {2} ({3})" },
    { "type": "disk",     "key": "󰋊 disk",     "keyColor": "224;136;48",  "format": "{1} / {2} ({9})" },
    "break",
    // ── Software (oliva/cobre — terciario, info)
    { "type": "shell",    "key": "󰆍 shell",    "keyColor": "138;128;48",  "format": "{3} {4}" },
    { "type": "packages", "key": "󰏗 pkgs",     "keyColor": "160;112;64" },
    { "type": "localip",  "key": "󰈀 ip",       "keyColor": "138;128;48",  "format": "{1}" },
    { "type": "colors",   "key": "󰏘 colors",   "keyColor": "232;192;32",  "symbol": "circle" }
  ]
}
