{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "NixOS",
    "color": {
      "1": "cyan",
      "2": "blue"
    },
    "padding": {
      "right": 2
    }
  },
  "display": {
    "separator": "  →  ",
    "color": {
      "separator": "cyan"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}",
      "color": {
        "user": "cyan",
        "at": "blue",
        "host": "blue"
      }
    },
    "break",
    { "type": "os",       "key": "OS",     "keyColor": "cyan" },
    { "type": "kernel",   "key": "Kernel", "keyColor": "blue" },
    { "type": "wm",       "key": "WM",     "keyColor": "cyan" },
    { "type": "terminal", "key": "Term",   "keyColor": "blue" },
    { "type": "shell",    "key": "Shell",  "keyColor": "cyan" },
    { "type": "cpu",      "key": "CPU",    "keyColor": "blue" },
    { "type": "memory",   "key": "RAM",    "keyColor": "cyan" },
    {
      "type": "disk",
      "key": "Disk",
      "keyColor": "blue",
      "folders": "/"
    },
    { "type": "uptime",   "key": "Up",     "keyColor": "cyan" },
    "break",
    { "type": "colors",   "symbol": "circle" }
  ]
}
