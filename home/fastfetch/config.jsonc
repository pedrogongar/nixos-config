{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "NixOS",
    "color": {
      "1": "yellow",
      "2": "red"
    },
    "padding": {
      "right": 2
    }
  },
  "display": {
    "separator": "  ▸  ",
    "color": {
      "separator": "white"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}",
      "color": {
        "user": "yellow",
        "at": "white",
        "host": "red"
      }
    },
    {
      "type": "separator",
      "string": "──────────────────"
    },
    { "type": "os",       "key": " OS",      "keyColor": "yellow" },
    { "type": "kernel",   "key": " Kernel",  "keyColor": "red"    },
    { "type": "wm",       "key": " WM",      "keyColor": "yellow" },
    { "type": "shell",    "key": " Shell",   "keyColor": "red"    },
    { "type": "terminal", "key": " Term",    "keyColor": "green"  },
    { "type": "cpu",      "key": " CPU",     "keyColor": "yellow" },
    {
      "type": "memory",
      "key": "󰍛 RAM",
      "keyColor": "red"
    },
    {
      "type": "disk",
      "key": "󰋊 Disk",
      "keyColor": "yellow",
      "folders": "/"
    },
    { "type": "uptime",   "key": "󰅐 Up",     "keyColor": "red"    },
    "break",
    { "type": "colors",   "symbol": "circle" }
  ]
}
