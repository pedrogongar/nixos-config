{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "~/.config/fastfetch/logo.png",
    "width": 32,
    "height": 16,
    "padding": { "top": 2, "right": 2 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "yellow",
      "output": "bright_white",
      "separator": "bright_white"
    },
    "key": {
      "width": 10
    },
    "percent": { "type": 9 }
  },
  "modules": [
    {
      "type": "custom",
      "format": "                {#magenta}occulta{#bright_white}@{#magenta}nixos"
    },
    {
      "type": "custom",
      "format": "{#bright_white}──────────────────────────────────────────────"
    },
    { "type": "os",       "key": "󰣇 distro",  "keyColor": "yellow",  "format": "{pretty-name}" },
    { "type": "kernel",   "key": "󰒋 kernel",  "keyColor": "yellow",  "format": "{release}" },
    { "type": "uptime",   "key": "󰅐 uptime",  "keyColor": "yellow",  "format": "{days}d {hours}h {minutes}m" },
    "break",
    { "type": "cpu",      "key": "󰻠 cpu",     "keyColor": "red",     "format": "{name}" },
    { "type": "gpu",      "key": "󰢮 gpu",     "keyColor": "red",     "format": "{name}" },
    { "type": "memory",   "key": "󰍛 mem",     "keyColor": "red",     "format": "{used} / {total} ({percentage})" },
    { "type": "disk",     "key": "󰋊 disk",    "keyColor": "red",     "format": "{size-used} / {size-total} ({size-percentage})" },
    "break",
    { "type": "shell",    "key": "󰆍 shell",   "keyColor": "magenta", "format": "{pretty-name}" },
    { "type": "terminal", "key": "󰞷 term",    "keyColor": "magenta", "format": "{pretty-name}" },
    { "type": "wm",       "key": "󰖲 wm",      "keyColor": "magenta", "format": "{pretty-name}" },
    { "type": "packages", "key": "󰏗 pkgs",    "keyColor": "magenta" },
    "break",
    { "type": "localip",  "key": "󰈀 ip",      "keyColor": "magenta", "format": "{ipv4}" },
    {
      "type": "custom",
      "format": "{#bright_white}──────────────────────────────────────────────"
    },
    { "type": "colors", "symbol": "circle", "paddingLeft": 15 }
  ]
}
