{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "NixOS",
    "color": {
      "1": "magenta",
      "2": "blue"
    },
    "padding": {
      "right": 2
    }
  },
  "display": {
    "separator": "  ▸  ",
    "color": {
      "separator": "white"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}",
      "color": {
        "user": "magenta",
        "at": "white",
        "host": "blue"
      }
    },
    {
      "type": "separator",
      "string": "──────────────────"
    },
    { "type": "os",       "key": " OS",      "keyColor": "magenta" },
    { "type": "kernel",   "key": " Kernel",  "keyColor": "cyan"    },
    { "type": "wm",       "key": " WM",      "keyColor": "blue"    },
    { "type": "shell",    "key": " Shell",   "keyColor": "magenta" },
    { "type": "terminal", "key": " Term",    "keyColor": "green"   },
    { "type": "cpu",      "key": " CPU",     "keyColor": "cyan"    },
    {
      "type": "memory",
      "key": "󰍛 RAM",
      "keyColor": "magenta"
    },
    {
      "type": "disk",
      "key": "󰋊 Disk",
      "keyColor": "blue",
      "folders": "/"
    },
    { "type": "uptime",   "key": "󰅐 Up",     "keyColor": "cyan"    },
    "break",
    { "type": "colors",   "symbol": "circle" }
  ]
}
